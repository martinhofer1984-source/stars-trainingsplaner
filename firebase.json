{
  "firestore": [
    { "database": "(default)", "rules": "firestore.rules" },
    { "database": "test", "rules": "firestore.rules" }
  ],
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      ".firebaserc",
      ".gitignore",
      "**/.*",
      ".git/**",
      ".firebase/**",
      "**/*.json",
      "**/node_modules/**",
      "functions/**",
      "docs-src/**"
    ],
    "headers": [
      {
        "source": "/@(sw.js|index.html)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
