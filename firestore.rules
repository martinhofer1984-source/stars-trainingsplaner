rules_version = '2';

// Access rules for the Stars Trainingsplaner.
//
// Who may do what is decided by the document members/{e-mail in lower case}:
//   role "trainer" (or no role, for the first members added in the console): everything
//   role "player": read the roster and the trainings, and say yes/no for the own
//                  player (playerId) up to 24 hours before the training starts
// Trainers are only ever created in the Firebase console. In the app a trainer can
// give access to players (role "player"), never to further trainers.
//
// Player strengths live in "players", which only trainers can read. Everything players
// may see (name, position) is copied into "roster".
service cloud.firestore {
  match /databases/{database}/documents {

    function myEmail() { return request.auth.token.email.lower(); }
    function myDoc() { return /databases/$(database)/documents/members/$(myEmail()); }

    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function isMember() { return signedIn() && exists(myDoc()); }
    function me() { return get(myDoc()).data; }
    // A single document lookup per check: Firestore limits lookups per request, and trainers
    // write several documents in one batch. get() on a missing document denies the request.
    // Developers (role "developer") have all trainer rights; the data backup is only shown to them in the app
    function isTrainer() { return signedIn() && me().get('role', 'trainer') in ['trainer', 'developer']; }
    function myPlayerId() { return me().get('playerId', ''); }
    // Trainers and the cashier manage the cash box
    function isKasse() { return signedIn() && me().get('role', 'trainer') in ['trainer', 'developer', 'cashier']; }

    // Optional jersey number 0-99
    function validNumber(d) {
      return !('number' in d) || (d.number is int && d.number >= 0 && d.number <= 99);
    }

    match /members/{email} {
      allow read: if isTrainer()
        || (request.auth != null && request.auth.token.email is string && email == myEmail());
      // Trainers hand out and change player access
      allow create: if isTrainer()
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['name', 'role', 'playerId'])
        && request.resource.data.role in ['player', 'cashier']
        && request.resource.data.name is string
        && request.resource.data.playerId is string;
      allow update: if isTrainer()
        && request.resource.data.keys().hasOnly(['name', 'role', 'playerId'])
        && (
          // a player's access
          (resource.data.get('role', 'trainer') in ['player', 'cashier'] && request.resource.data.role in ['player', 'cashier'])
          // a trainer links or unlinks the own player entry, nothing else
          || (email == myEmail()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerId']))
        );
      allow delete: if isTrainer() && resource.data.get('role', 'trainer') in ['player', 'cashier'];
    }

    match /players/{playerId} {
      allow read, delete: if isTrainer();
      allow create, update: if isTrainer()
        && request.resource.data.keys().hasOnly(['name', 'pos', 'rating', 'active', 'email', 'number', 'material'])
        && (!('material' in request.resource.data) || request.resource.data.material is bool)
        && validNumber(request.resource.data)
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.pos in ['G', 'D', 'O']
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 10
        && request.resource.data.active is bool
        && (!('email' in request.resource.data) || request.resource.data.email is string);
    }

    match /roster/{playerId} {
      allow read: if isMember();
      allow delete: if isTrainer();
      allow create, update: if isTrainer()
        && request.resource.data.keys().hasOnly(['name', 'pos', 'active', 'access', 'number', 'material'])
        && (!('material' in request.resource.data) || request.resource.data.material is bool)
        && validNumber(request.resource.data)
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.pos in ['G', 'D', 'O']
        && request.resource.data.active is bool
        && request.resource.data.access is bool;
    }

    match /trainings/{trainingId} {
      allow read: if isMember();
      allow delete: if isTrainer();
      allow create: if isTrainer() && validTraining(request.resource.data);
      allow update: if (isTrainer() && validTraining(request.resource.data))
        || ownAnswer() || ownMaterial();

      function validTraining(t) {
        return t.keys().hasOnly(['start', 'place', 'kind', 'note', 'cancelled', 'responses', 'teams', 'lines', 'duration', 'noshow', 'result', 'bulk', 'createdAt', 'wait', 'material'])
          && (!('wait' in t) || (t.wait is list && t.wait.size() <= 60))
          && (!('material' in t) || t.material == null || (t.material is map
              && t.material.keys().hasOnly(['pid', 'state'])
              && t.material.pid is string
              && t.material.state in ['asked', 'yes', 'no']))
          && (!('bulk' in t) || t.bulk is bool)
          && (!('result' in t) || t.result == null || (t.result is map
              && t.result.keys().hasOnly(['a', 'b'])
              && t.result.a is int && t.result.a >= 0 && t.result.a <= 99
              && t.result.b is int && t.result.b >= 0 && t.result.b <= 99))
          && (!('noshow' in t) || t.noshow is list)
          && (!('duration' in t) || (t.duration is int && t.duration >= 15 && t.duration <= 600))
          && (!('kind' in t) || t.kind in ['training', 'game'])
          && t.start is timestamp
          && t.place is string && t.place.size() <= 80
          && t.note is string && t.note.size() <= 200
          && t.cancelled is bool
          && t.responses is map
          && (!('lines' in t) || t.lines == null || validLines(t.lines));
      }

      // A player changes only the own answer, only to yes/no, up to 24 h before the start
      function ownAnswer() {
        return isMember()
          && myPlayerId() != ''
          && resource.data.get('cancelled', false) == false
          && request.time < resource.data.start - duration.value(24, 'h')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responses'])
          && request.resource.data.responses.diff(resource.data.responses).affectedKeys().hasOnly([myPlayerId()])
          && request.resource.data.responses[myPlayerId()] in ['in', 'out'];
      }

      // The player asked to bring the material answers yes or no (until the appointment starts)
      function ownMaterial() {
        return isMember()
          && myPlayerId() != ''
          && resource.data.get('material', null) is map
          && resource.data.material.pid == myPlayerId()
          && request.time < resource.data.start
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['material'])
          && request.resource.data.material.keys().hasOnly(['pid', 'state'])
          && request.resource.data.material.pid == myPlayerId()
          && request.resource.data.material.state in ['yes', 'no'];
      }
    }

    // Lines for a game: number of defence and forward lines, per player "G" (goal), "V1".."V4" or "S1".."S4"
    function validLines(l) {
      return l is map
        && l.keys().hasOnly(['d', 'o', 'slot', 'at'])
        && l.d is int && l.d >= 1 && l.d <= 4
        && l.o is int && l.o >= 1 && l.o <= 4
        && l.slot is map;
    }

    // Drafts of teams (training) or lines (game): only trainers; players see them once a
    // trainer copies them into the training
    match /drafts/{trainingId} {
      allow read, delete: if isTrainer();
      allow create, update: if isTrainer()
        && request.resource.data.keys().hasOnly(['A', 'B', 'lines', 'at'])
        && (!('A' in request.resource.data) || request.resource.data.A is list)
        && (!('B' in request.resource.data) || request.resource.data.B is list)
        && (!('lines' in request.resource.data) || validLines(request.resource.data.lines));
    }

    // Team info: trainers write messages, everybody reads them. Automatic entries come from the
    // Cloud Functions (admin access, not bound by these rules).
    match /news/{id} {
      allow read: if isMember();
      allow delete: if isTrainer();
      allow create: if isTrainer()
        && request.resource.data.keys().hasOnly(['title', 'text', 'at', 'by', 'kind', 'options', 'votes'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && request.resource.data.by is string && request.resource.data.by.size() <= 80
        && request.resource.data.at is timestamp
        && ((request.resource.data.kind == 'info' && !('options' in request.resource.data) && !('votes' in request.resource.data))
          || (request.resource.data.kind == 'poll'
              && request.resource.data.options is list
              && request.resource.data.options.size() >= 2 && request.resource.data.options.size() <= 8
              && request.resource.data.votes == {}));
      // Polls: every player sets or removes only the own vote (index of an option)
      allow update: if isMember()
        && resource.data.kind == 'poll'
        && myPlayerId() != ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && request.resource.data.votes is map
        && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([myPlayerId()])
        && (!(myPlayerId() in request.resource.data.votes)
            || (request.resource.data.votes[myPlayerId()] is int
                && request.resource.data.votes[myPlayerId()] >= 0
                && request.resource.data.votes[myPlayerId()] < resource.data.options.size()));
    }

    // Player profile: the birthday (month-day, no year) is entered by the player in the app
    match /profiles/{pid} {
      allow read: if isMember();
      allow create, update: if isMember() && pid == myPlayerId()
        && request.resource.data.keys().hasOnly(['birthday'])
        && request.resource.data.birthday is string
        && request.resource.data.birthday.matches('^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
      allow delete: if isMember() && pid == myPlayerId();
    }

    // Push tokens: each member registers and removes the own devices; nobody reads them
    // (the Cloud Functions do, with admin access). The token itself is the document id.
    match /tokens/{token} {
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['email', 'at'])
        && request.resource.data.email == myEmail()
        && request.resource.data.at is number;
      allow delete: if signedIn() && resource.data.email == myEmail();
    }

    // Cash box settings: tariffs per season, start date, extra costs per game. Everybody reads
    // them (to see the own balance), trainers and the cashier write them.
    match /kasse/{doc} {
      allow read: if isMember();
      allow create, update: if isKasse() && doc == 'settings'
        && request.resource.data.keys().hasOnly(['startAt', 'seasons', 'gameCost'])
        && (!('startAt' in request.resource.data) || request.resource.data.startAt is number)
        && (!('seasons' in request.resource.data) || request.resource.data.seasons is map)
        && (!('gameCost' in request.resource.data) || request.resource.data.gameCost is map);
    }

    // Payments per player (plan and paid items). A player reads only the own entry.
    match /billing/{pid} {
      allow read: if isKasse() || (isMember() && pid == myPlayerId());
      allow create, update: if isKasse()
        && request.resource.data.keys().hasOnly(['plan', 'paid'])
        && (!('plan' in request.resource.data) || request.resource.data.plan in ['training', 'student', 'annual', 'free'])
        && (!('paid' in request.resource.data) || request.resource.data.paid is map);
    }

    // Fines: trainers give and delete them; trainers and the cashier see all, a player only the own
    match /fines/{id} {
      allow read: if isKasse() || (isMember() && resource.data.pid == myPlayerId());
      allow delete: if isTrainer();
      allow create: if isTrainer()
        && request.resource.data.keys().hasOnly(['pid', 'reason', 'amount', 'at', 'by'])
        && request.resource.data.pid is string
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 200
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 1000
        && request.resource.data.at is timestamp
        && request.resource.data.by is string;
    }

    // Cash book: expenses and corrections. Whoever enters one signs it with the own address;
    // a second person (trainer or cashier) confirms it. Confirmed entries can no longer change.
    match /ledger/{id} {
      allow read: if isKasse();
      allow create: if isKasse()
        && request.resource.data.keys().hasOnly(['type', 'date', 'text', 'amount', 'by', 'byName', 'at'])
        && request.resource.data.type in ['expense', 'correction']
        && request.resource.data.date is number
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
        && request.resource.data.amount is number && request.resource.data.amount != 0
        && request.resource.data.amount >= -100000 && request.resource.data.amount <= 100000
        && (request.resource.data.type == 'correction' || request.resource.data.amount > 0)
        && request.resource.data.by == myEmail()
        && request.resource.data.byName is string
        && request.resource.data.at is timestamp;
      // Four-eyes principle: only the confirmation fields, only once, never by the author
      allow update: if isKasse()
        && !('confirmedBy' in resource.data)
        && resource.data.by != myEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmedBy', 'confirmedByName', 'confirmedAt'])
        && request.resource.data.confirmedBy == myEmail()
        && request.resource.data.confirmedByName is string
        && request.resource.data.confirmedAt is timestamp;
      // Unconfirmed entries may be withdrawn by the author or a trainer
      allow delete: if isKasse() && !('confirmedBy' in resource.data)
        && (resource.data.by == myEmail() || isTrainer());
    }

    // Absences (sick, holiday): a player reports the own, a trainer anybody's. The time of the
    // report comes from the server, so nobody can backdate a report to get in before the deadline.
    // Reports after a deadline are confirmed per appointment by a trainer (map "confirmed").
    match /absences/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['pid', 'from', 'to', 'reason', 'note', 'by', 'byName', 'byTrainer', 'at'])
        && request.resource.data.pid is string
        && (request.resource.data.pid == myPlayerId() || isTrainer())
        && request.resource.data.from is number && request.resource.data.to is number
        && request.resource.data.to >= request.resource.data.from
        && request.resource.data.to - request.resource.data.from <= 31708800000
        && request.resource.data.reason in ['krank', 'urlaub', 'sonstiges']
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 200))
        && request.resource.data.by == myEmail()
        && request.resource.data.byName is string
        && request.resource.data.byTrainer == isTrainer()
        && request.resource.data.at == request.time;
      allow update: if
        // a trainer confirms late reports
        (isTrainer() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmed'])
          && request.resource.data.confirmed is map)
        // the author ends the absence early (only shorter, never before its start)
        || (signedIn() && resource.data.by == myEmail()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['to'])
          && request.resource.data.to >= resource.data.from && request.resource.data.to <= resource.data.to);
      allow delete: if isTrainer() || (signedIn() && resource.data.by == myEmail());
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
