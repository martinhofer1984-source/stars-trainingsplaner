rules_version = '2';

// Access rules for the Stars Trainingsplaner.
// Only signed-in users whose e-mail address has a document in the "members" collection
// (document ID = e-mail address in lower case) may read or change data.
// Members are added and removed in the Firebase console only, never from the app.
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/members/$(request.auth.token.email.lower()));
    }

    match /members/{email} {
      allow read: if isMember();
      allow write: if false;
    }

    match /players/{playerId} {
      allow read, delete: if isMember();
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['name', 'pos', 'rating', 'active'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.pos in ['G', 'D', 'O']
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 10
        && request.resource.data.active is bool;
    }

    match /state/current {
      allow read, write: if isMember();
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
